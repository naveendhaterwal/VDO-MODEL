{
  "version": "0.1",
  "type": "container",
  "ops": [
    {
      "type": "container/run",
      "id": "Cinematic-Worker",
      "args": {
        "image": "docker.io/naveendhaterwal/vimax:latest",
        "cmd": [
          "/bin/bash",
          "/app/scripts/start_worker.sh"
        ],
        "expose": 8000,
        "gpu": true,
        "env": {
          "REDIS_URL": "redis://localhost:6379",
          "MODEL_DIR": "/app/models",
          "OUTPUT_DIR": "/app/outputs",
          "RQ_QUEUE": "cinematic_jobs"
        }
      }
    }
  ],
  "deployment_id": "ASSX3fSQmQE7CnZ6DgppANtueqsJL2qmeZmpzKLiVdRq",
  "meta": {
    "trigger": "deployment-manager",
    "system_requirements": {
      "required_vram": 24
    }
  }
}
