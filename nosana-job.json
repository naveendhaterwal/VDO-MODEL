{
  "version": "0.1",
  "type": "container",
  "meta": {
    "trigger": "dashboard",
    "system_requirements": {
      "required_vram": 40,
      "min_vram": 40,
      "recommended_gpu": "A100 40GB",
      "min_cuda_version": "12.1",
      "recommended_disk": 100
    }
  },
  "ops": [
    {
      "id": "Cinematic-Worker",
      "type": "container/run",
      "args": {
        "image": "docker.io/naveendhaterwal/vimax:latest",
        "cmd": [
          "/bin/bash",
          "/app/scripts/start_worker.sh"
        ],
        "gpu": true,
        "expose": {
          "port": 8000,
          "health_checks": [
            {
              "type": "http",
              "method": "GET",
              "path": "/health",
              "expected_status": 200,
              "continuous": true
            }
          ]
        },
        "env": {
          "REDIS_URL": "redis://localhost:6379",
          "MODEL_DIR": "/app/models",
          "OUTPUT_DIR": "/app/outputs"
        }
      }
    }
  ]
}
