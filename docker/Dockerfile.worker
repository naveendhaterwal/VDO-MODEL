FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV VRAM_LIMIT_GB=24

# Install system dependencies (including redis-server for local queue)
RUN apt-get update && apt-get install -y \
    python3.10 python3.10-venv python3-pip \
    git ffmpeg libsm6 libxext6 \
    wget curl unzip \
    redis-server \
    && rm -rf /var/lib/apt/lists/*

# Set up Python symlinks
RUN ln -s /usr/bin/python3.10 /usr/bin/python

# Upgrade pip
RUN python -m pip install --upgrade pip

# Create workspace
WORKDIR /app

# Install PyTorch - use 2.3.1 which is the latest available for cu121 on x86_64 Linux
RUN pip install torch==2.3.1 torchvision==0.18.1 torchaudio==2.3.1 --index-url https://download.pytorch.org/whl/cu121

# Install diffusers, transformers, accelerate, vLLM (optional), fastAPI, redis, rq, and other dependencies
RUN pip install \
    diffusers[torch] \
    transformers \
    accelerate \
    safetensors \
    redis \
    rq \
    fastapi \
    uvicorn \
    pydantic \
    moviepy \
    python-dotenv \
    hf_transfer \
    huggingface_hub \
    prometheus-client

# Enable faster downloads
ENV HF_HUB_ENABLE_HF_TRANSFER=1
# HuggingFace token - pass at runtime via Nosana env vars for gated models
ENV HF_TOKEN=""

# Copy source code
COPY . /app/

# Entrypoint will handle model preloading and worker start
CMD ["bash", "/app/scripts/start_worker.sh"]
