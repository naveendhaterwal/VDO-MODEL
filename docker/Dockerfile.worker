# Stage 1: Build Frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

# Stage 2: Runtime Environment
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV VRAM_LIMIT_GB=24
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# 1. Install System Dependencies (Hardened)
RUN apt-get update && apt-get install -y \
    python3.10 python3.10-venv python3-pip \
    git ffmpeg libsm6 libxext6 \
    libgl1-mesa-glx libglib2.0-0 \
    procps wget curl unzip \
    redis-server \
    && rm -rf /var/lib/apt/lists/*

RUN ln -s /usr/bin/python3.10 /usr/bin/python && \
    python -m pip install --upgrade pip

WORKDIR /app

# 2. Install Core AI Stack (Pinned & Verified)
# Pinning to specific compatible release for RTX 4090 / CUDA 12.1
RUN pip install --no-cache-dir \
    torch==2.4.1 \
    torchvision==0.19.1 \
    torchaudio==2.4.1 \
    --index-url https://download.pytorch.org/whl/cu121

# 3. Install Transitive Dependencies (Pinned to prevent future breakages)
RUN pip install --no-cache-dir \
    "diffusers==0.38.0" \
    "transformers==4.49.0" \
    "accelerate==0.34.2" \
    "safetensors==0.4.5" \
    "bitsandbytes==0.43.3" \
    "pydantic<2.0.0" \
    "moviepy<2.0.0" \
    "fastapi==0.115.0" \
    "uvicorn==0.30.6" \
    "redis==5.0.8" \
    "rq==1.16.2" \
    "python-dotenv==1.0.1" \
    "hf_transfer==0.1.8" \
    "huggingface_hub==0.25.1" \
    "prometheus-client==0.21.0" \
    "protobuf==5.28.2" \
    "sentencepiece==0.2.0"

# 4. Copy Code
COPY . /app/
COPY --from=frontend-builder /app/frontend/out /app/frontend/out

# 5. Runtime Checks & Startup
# HEALTHCHECK to notify Nosana if the container stalls
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["bash", "/app/scripts/start_worker.sh"]
