FROM node:20.14.0-alpine AS frontend-builder

WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_DISABLE_SYMLINKS_WARNING=1 \
    HF_HOME=/root/.cache/huggingface \
    MODEL_DIR=/app/models \
    OUTPUT_DIR=/app/outputs \
    APP_IMAGE_TAG=v1.0.0 \
    APP_EXPECTED_TORCH=2.6.0 \
    APP_EXPECTED_TORCH_CUDA=12.6 \
    APP_EXPECTED_TRANSFORMERS=4.49.0 \
    APP_EXPECTED_DIFFUSERS=0.38.0 \
    APP_EXPECTED_BITSANDBYTES=0.47.0 \
    MIN_GPU_VRAM_GB=40 \
    ENABLE_BNB_4BIT=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    ffmpeg \
    git \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    pkg-config \
    procps \
    python3.10 \
    python3.10-venv \
    python3-pip \
    redis-server \
    redis-tools \
    tini \
    unzip \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3.10 /usr/local/bin/python && \
    ln -sf /usr/bin/pip3 /usr/local/bin/pip && \
    python --version && \
    python -m pip install --upgrade pip==23.3.2 setuptools==70.0.0 wheel==0.43.0

WORKDIR /app

COPY requirements.txt /app/requirements.txt

RUN python -m pip install \
    torch==2.6.0 \
    torchvision==0.21.0 \
    torchaudio==2.6.0 \
    --index-url https://download.pytorch.org/whl/cu126

RUN python -m pip install xformers==0.0.29.post3 --index-url https://download.pytorch.org/whl/cu126
RUN python -m pip install -r /app/requirements.txt

COPY backend /app/backend
COPY monitoring /app/monitoring
COPY orchestration /app/orchestration
COPY pipelines /app/pipelines
COPY providers /app/providers
COPY scripts /app/scripts
COPY storage /app/storage
COPY tests /app/tests
COPY workers /app/workers
COPY frontend/package.json /app/frontend/package.json
COPY --from=frontend-builder /app/frontend/out /app/frontend/out
COPY nosana-job.json /app/nosana-job.json
COPY test_api_flow.py /app/test_api_flow.py

RUN chmod +x /app/scripts/start_worker.sh && \
    mkdir -p /app/models /app/outputs /run/nvidia-persistenced

HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/app/scripts/start_worker.sh"]
